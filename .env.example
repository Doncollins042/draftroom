# PostgreSQL — canonical store (messages, drafts, audit)
DATABASE_URL="postgresql://user:password@localhost:5432/draftroom"

# Auth.js session signing secret — generate with: npx auth secret
AUTH_SECRET=""

# Anthropic — draft generation (Claude)
ANTHROPIC_API_KEY=""

# Voyage AI — embeddings for the style-exemplar index
VOYAGE_API_KEY=""

# Pinecone — vector store for style exemplars
PINECONE_API_KEY=""
PINECONE_INDEX="draftroom-exemplars"

# WhatsApp Business Cloud API (Meta)
# From developers.facebook.com -> your app -> WhatsApp -> API setup
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account id (WABA) — needed for template sync
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# You invent this string, then paste the same value in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=""
# App secret from app settings -> Basic; used to verify webhook signatures
WHATSAPP_APP_SECRET=""
